<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        注意：这个 BOM 刻意不继承 domain-driven-kit 父 pom。

        BOM 的用途是被下游项目 <scope>import</scope>，如果它继承了一个带
        spring-boot-starter-parent 的父 pom，下游 import 时会连带引入父 pom 的
        pluginManagement 与 dependencies，产生意料之外的约束。
        独立的 BOM 只声明 dependencyManagement，是标准做法。
    -->
    <groupId>com.ddk</groupId>
    <artifactId>ddk-dependencies</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>DDK Dependencies (BOM)</name>
    <description>Bill of Materials for Domain Driven Kit - 下游项目 import 后无需再写 DDK 模块的版本号</description>
    <url>https://github.com/poppycoderr/domain-driven-kit</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Elijah Du</name>
            <url>https://github.com/poppycoderr</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/poppycoderr/domain-driven-kit</url>
        <connection>scm:git:https://github.com/poppycoderr/domain-driven-kit.git</connection>
        <developerConnection>scm:git:git@github.com:poppycoderr/domain-driven-kit.git</developerConnection>
    </scm>

    <properties>
        <ddk.version>0.2.0-SNAPSHOT</ddk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 核心抽象 -->
            <dependency>
                <groupId>com.ddk</groupId>
                <artifactId>ddk-core</artifactId>
                <version>${ddk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ddk</groupId>
                <artifactId>ddk-mybatis</artifactId>
                <version>${ddk.version}</version>
            </dependency>

            <!-- Starters -->
            <dependency>
                <groupId>com.ddk</groupId>
                <artifactId>ddk-web-starter</artifactId>
                <version>${ddk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ddk</groupId>
                <artifactId>ddk-mybatis-starter</artifactId>
                <version>${ddk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ddk</groupId>
                <artifactId>ddk-redis-starter</artifactId>
                <version>${ddk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ddk</groupId>
                <artifactId>ddk-cache-starter</artifactId>
                <version>${ddk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ddk</groupId>
                <artifactId>ddk-db-starter</artifactId>
                <version>${ddk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ddk</groupId>
                <artifactId>ddk-tracer-starter</artifactId>
                <version>${ddk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ddk</groupId>
                <artifactId>ddk-seata-starter</artifactId>
                <version>${ddk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ddk</groupId>
                <artifactId>ddk-archguard-starter</artifactId>
                <version>${ddk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ddk</groupId>
                <artifactId>ddk-event-starter</artifactId>
                <version>${ddk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ddk</groupId>
                <artifactId>ddk-mcp-starter</artifactId>
                <version>${ddk.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- BOM 不继承父 pom，也没有源码；声明 Spotless 只是为了让 mvn spotless:apply 在整个 reactor 上可用 -->
    <build>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>2.44.5</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
