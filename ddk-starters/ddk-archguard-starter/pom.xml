<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ddk</groupId>
        <artifactId>ddk-starters</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>ddk-archguard-starter</artifactId>
    <name>DDK ArchGuard Starter</name>
    <description>Architecture governance with ArchUnit - predefined layered architecture rules</description>

    <dependencies>
        <dependency>
            <groupId>com.ddk</groupId>
            <artifactId>ddk-core</artifactId>
        </dependency>

        <!--
            compile 作用域是刻意的：CommonArchRules 的公开 API 直接返回 ArchRule，
            下游要使用这些常量就必须能看到 ArchUnit 类型。
            前提是下游按文档用 <scope>test</scope> 引入本模块，
            这样 ArchUnit 只会落在下游的测试类路径上。
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5-api</artifactId>
            <version>${archunit.version}</version>
        </dependency>

        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5-engine</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- 只用于构造 MCP 工具规则的测试夹具；规则本身按注解全限定名匹配，不依赖 Spring AI -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-mcp-annotations</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
